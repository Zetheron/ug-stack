digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 9 - Quiz dan Sertifikat"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Pengguna memilih satu\njawaban untuk tiap soal", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Ada soal yang belum\ndijawab?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
e [label="Tampilkan: jawab semua soal", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p1 [label="benar = 0; untuk setiap\nsoal: jika jawaban = kunci\nmaka benar + 1", shape="box", style="filled", fillcolor="#FFFFFF"];
p2 [label="persen = benar x 100 /\njumlah soal; lulus = persen\n>= 70", shape="box", style="filled", fillcolor="#FFFFFF"];
d3 [label="Pengguna sudah\nlogin?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Simpan skor terbaik (maks)\ndan tambah jumlah percobaan", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Lulus dan belum\npunya tanggal lulus?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p4 [label="Catat tanggal lulus", shape="box", style="filled", fillcolor="#FFFFFF"];
d5 [label="Lulus?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o1 [label="Tampilkan nilai, penjelasan,\ndan tombol sertifikat (kode\n= SHA-256 (pengguna, bahasa,\ntanggal), 10 karakter)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
o2 [label="Tampilkan nilai dan\npenjelasan; sarankan belajar\nulang", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
o3 [label="Tampilkan nilai dan ajakan\nlogin untuk menyimpan skor", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> d1;
d1 -> e [label="Ya"];
d1 -> p1 [label="Tidak"];
p1 -> p2;
p2 -> d3;
d3 -> o3 [label="Tidak"];
d3 -> p3 [label="Ya"];
p3 -> d4;
d4 -> p4 [label="Ya"];
d4 -> d5 [label="Tidak"];
p4 -> d5;
d5 -> o1 [label="Ya"];
d5 -> o2 [label="Tidak"];
e -> x;
o1 -> x;
o2 -> x;
o3 -> x;
}