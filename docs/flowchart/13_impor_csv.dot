digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 13 - Impor Modul dari CSV"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Admin menempel teks CSV", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d0 [label="Pengguna admin?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d1 [label="Teks kosong atau >\n200.000 karakter?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Kolom wajib (judul,\nbahasa, level,\ndurasi) lengkap?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Baca modul saat ini; siapkan\nID berikutnya", shape="box", style="filled", fillcolor="#FFFFFF"];
d3 [label="Masih ada baris\nberikutnya? (for)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d4 [label="Baris valid?\n(validate_module)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d5 [label="Judul dan bahasa\nsudah ada?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Tambahkan modul dengan ID\nbaru; jumlah ditambah + 1", shape="box", style="filled", fillcolor="#FFFFFF"];
p3 [label="Catat baris dilewati beserta\nalasan", shape="box", style="filled", fillcolor="#FFFFFF"];
p4 [label="Simpan modules.json sekali;\ncatat audit IMPOR_CSV", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Tampilkan ringkasan:\nditambah dan dilewati (nomor\nbaris + alasan)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e [label="Tampilkan pesan kesalahan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> d0;
d0 -> e [label="Tidak"];
d0 -> d1 [label="Ya"];
d1 -> e [label="Ya"];
d1 -> d2 [label="Tidak"];
d2 -> e [label="Tidak"];
d2 -> p1 [label="Ya"];
p1 -> d3;
d3 -> d4 [label="Ya"];
d4 -> p3 [label="Tidak"];
d4 -> d5 [label="Ya"];
d5 -> p3 [label="Ya"];
d5 -> p2 [label="Tidak"];
p2 -> d3;
p3 -> d3;
d3 -> p4 [label="Tidak"];
p4 -> o;
o -> x;
e -> x;
}