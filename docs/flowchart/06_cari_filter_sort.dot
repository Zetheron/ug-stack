digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 6 - Pencarian, Filter, dan Pengurutan"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Input kata kunci, bahasa,\nkunci urut, naik/turun", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p0 [label="hasil = daftar kosong", shape="box", style="filled", fillcolor="#FFFFFF"];
d1 [label="Masih ada modul\nberikutnya?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Bahasa bukan Semua\ndan bahasa modul\ntidak sama?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d3 [label="Kata kunci diisi dan\ntidak ada di judul\natau deskripsi?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Tambahkan modul ke hasil", shape="box", style="filled", fillcolor="#FFFFFF"];
p2 [label="Urutkan hasil menurut judul\n/ durasi / level, naik atau\nturun", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Tampilkan kartu modul dan\njumlahnya", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> p0;
p0 -> d1;
d1 -> d2 [label="Ya"];
d2 -> d1 [label="Ya (lewati)"];
d2 -> d3 [label="Tidak"];
d3 -> d1 [label="Ya (lewati)"];
d3 -> p1 [label="Tidak"];
p1 -> d1;
d1 -> p2 [label="Tidak"];
p2 -> o;
o -> x;
}