digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 14 - Ganti Password (termasuk wajib ganti)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
d0 [label="Login membawa tanda\npassword\nsementara/bawaan?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
w [label="Tampilkan dialog wajib ganti\n(tidak bisa ditutup)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
in [label="Input password lama, baru,\nulangi baru", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Password baru valid?\n(min 8, huruf dan\nangka)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Konfirmasi sama?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d3 [label="Password lama benar?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d4 [label="Password baru\nberbeda dari lama?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Buat salt baru; hash\npassword baru; hapus tanda\nwajib ganti; simpan; catat\nGANTI_PASSWORD", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Tampilkan: password berhasil\ndiubah", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e [label="Tampilkan pesan kesalahan\n(dialog tetap terbuka)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> d0;
d0 -> w [label="Ya"];
d0 -> in [label="Tidak (ganti manual)"];
w -> in;
in -> d1;
d1 -> e [label="Tidak"];
d1 -> d2 [label="Ya"];
d2 -> e [label="Tidak"];
d2 -> d3 [label="Ya"];
d3 -> e [label="Tidak"];
d3 -> d4 [label="Ya"];
d4 -> e [label="Tidak"];
d4 -> p1 [label="Ya"];
p1 -> o;
o -> x;
e -> in;
}