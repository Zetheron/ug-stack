digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 11 - Merge Sort (urut stabil)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Daftar data, fungsi kunci,\narah urut", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Jumlah data <= 1?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o1 [label="Kembalikan salinan data", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p1 [label="Bagi dua: kiri dan kanan;\nurutkan masing-masing secara\nrekursif", shape="box", style="filled", fillcolor="#FFFFFF"];
p2 [label="i = 0; j = 0; hasil = daftar\nkosong", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="i < panjang kiri DAN\nj < panjang kanan?\n(while)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d3 [label="Kiri harus lebih\ndulu? (kunci kiri <=\nkanan; menurun: >=)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Tambahkan kiri[i] ke hasil;\ni + 1", shape="box", style="filled", fillcolor="#FFFFFF"];
p4 [label="Tambahkan kanan[j] ke hasil;\nj + 1", shape="box", style="filled", fillcolor="#FFFFFF"];
p5 [label="Tambahkan sisa kiri dan sisa\nkanan ke hasil", shape="box", style="filled", fillcolor="#FFFFFF"];
o2 [label="Kembalikan hasil terurut", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> d1;
d1 -> o1 [label="Ya"];
d1 -> p1 [label="Tidak"];
p1 -> p2;
p2 -> d2;
d2 -> d3 [label="Ya"];
d3 -> p3 [label="Ya"];
d3 -> p4 [label="Tidak"];
p3 -> d2;
p4 -> d2;
d2 -> p5 [label="Tidak"];
p5 -> o2;
o1 -> x;
o2 -> x;
}