digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 5 - Hapus Modul (Admin)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
d0 [label="Pengguna adalah\nadmin?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
in [label="Pilih modul; dialog\nkonfirmasi hapus", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Admin menekan Hapus?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Baca modules.json; buang\nmodul ber-ID tersebut", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="Jumlah modul\nberkurang?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Simpan modules.json", shape="box", style="filled", fillcolor="#FFFFFF"];
p3 [label="Hapus ID modul dari progres\nsemua mahasiswa; simpan\nprogress.json", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Tampilkan: modul dihapus;\nmuat ulang daftar", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e0 [label="Tampilkan: hanya admin", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e1 [label="Tampilkan: modul tidak\nditemukan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
c [label="Batal", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> d0;
d0 -> e0 [label="Tidak"];
d0 -> in [label="Ya"];
in -> d1;
d1 -> c [label="Batal"];
d1 -> p1 [label="Ya"];
p1 -> d2;
d2 -> e1 [label="Tidak"];
d2 -> p2 [label="Ya"];
p2 -> p3;
p3 -> o;
o -> x;
e0 -> x;
e1 -> x;
}