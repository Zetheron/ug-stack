digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 2 - Login"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Input username dan password", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Username atau\npassword kosong?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Akun sedang\nterkunci? (baca\nlockouts.json)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Baca users.json", shape="box", style="filled", fillcolor="#FFFFFF"];
d3 [label="File berhasil\ndibaca?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Cari username; hash password\n(salt pengguna, atau salt\ntiruan bila username tidak\nada)", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Username ada dan\nhash cocok?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Reset hitungan gagal; catat\nLOGIN_OK; simpan pengguna di\nsesi", shape="box", style="filled", fillcolor="#FFFFFF"];
o1 [label="Tampilkan Login berhasil;\nbuka Dashboard (jika\npassword sementara: wajib\nganti, Flowchart 14)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p4 [label="Tambah hitungan gagal", shape="box", style="filled", fillcolor="#FFFFFF"];
d5 [label="Hitungan gagal >= 3?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p5 [label="Kunci akun 30 detik (simpan\nke lockouts.json)", shape="box", style="filled", fillcolor="#FFFFFF"];
e1 [label="Tampilkan: wajib diisi", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e2 [label="Tampilkan: akun terkunci,\ntunggu", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e3 [label="Tampilkan pesan kesalahan\nfile", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e4 [label="Tampilkan: akun dikunci", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e5 [label="Tampilkan: salah, sisa\npercobaan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> d1;
d1 -> e1 [label="Ya"];
d1 -> d2 [label="Tidak"];
d2 -> e2 [label="Ya"];
d2 -> p1 [label="Tidak"];
p1 -> d3;
d3 -> e3 [label="Tidak"];
d3 -> p2 [label="Ya"];
p2 -> d4;
d4 -> p3 [label="Ya"];
p3 -> o1;
d4 -> p4 [label="Tidak"];
p4 -> d5;
d5 -> p5 [label="Ya"];
p5 -> e4;
d5 -> e5 [label="Tidak"];
o1 -> x;
e1 -> x;
e2 -> x;
e3 -> x;
e4 -> x;
e5 -> x;
}