digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 10 - Pencarian Biner (get_module)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Daftar modul terurut menurut\nID, ID yang dicari", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p1 [label="rendah = 0; tinggi = jumlah\nmodul - 1", shape="box", style="filled", fillcolor="#FFFFFF"];
d1 [label="rendah <= tinggi?\n(while)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="tengah = (rendah + tinggi)\ndiv 2", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="ID di tengah = ID\ndicari?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o1 [label="Kembalikan modul pada indeks\ntengah", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d3 [label="ID di tengah < ID\ndicari?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="rendah = tengah + 1", shape="box", style="filled", fillcolor="#FFFFFF"];
p4 [label="tinggi = tengah - 1", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Tidak ketemu: coba\npencarian linear\n(jaga-jaga)?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o2 [label="Kembalikan hasil linear atau\n'tidak ditemukan'", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> p1;
p1 -> d1;
d1 -> p2 [label="Ya"];
p2 -> d2;
d2 -> o1 [label="Ya"];
d2 -> d3 [label="Tidak"];
d3 -> p3 [label="Ya"];
d3 -> p4 [label="Tidak"];
p3 -> d1;
p4 -> d1;
d1 -> d4 [label="Tidak"];
d4 -> o2 [label="Ya"];
o1 -> x;
o2 -> x;
}