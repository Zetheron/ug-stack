digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 18 - Tema Gelap/Terang dan Bahasa Indonesia/Inggris"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai (aplikasi dibuka)", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
p1 [label="Baca preferensi tema dan\nbahasa dari penyimpanan\nperangkat", shape="box", style="filled", fillcolor="#FFFFFF"];
d1 [label="Tema pernah dipilih?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Ikuti tema perangkat\n(terang/gelap)", shape="box", style="filled", fillcolor="#FFFFFF"];
p3 [label="Pakai tema tersimpan", shape="box", style="filled", fillcolor="#FFFFFF"];
p4 [label="Bahasa = tersimpan atau\nIndonesia (bawaan)", shape="box", style="filled", fillcolor="#FFFFFF"];
r [label="Bangun tampilan; terjemahkan\nseluruh pohon kontrol\nsebelum ditampilkan", shape="box", style="filled", fillcolor="#FFFFFF"];
t [label="Tampilkan halaman", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d2 [label="Pengguna menekan\ntombol tema atau\nbahasa?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
a [label="Balik tema (terang/gelap)\natau bahasa (ID/EN); simpan\npreferensi ke perangkat", shape="box", style="filled", fillcolor="#FFFFFF"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> p1;
p1 -> d1;
d1 -> p3 [label="Ya"];
d1 -> p2 [label="Tidak"];
p2 -> p4;
p3 -> p4;
p4 -> r;
r -> t;
t -> d2;
d2 -> a [label="Ya"];
a -> r;
d2 -> x [label="Tidak"];
}