digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 8 - Pengambilan Konten Otomatis (dengan Cache)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Halaman memerlukan konten\ndari sumber (kunci cache,\nfungsi pengambil)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p1 [label="Baca file cache berdasarkan\nkunci", shape="box", style="filled", fillcolor="#FFFFFF"];
d1 [label="Cache ada dan\numurnya < 24 jam?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o1 [label="Tampilkan data dari cache", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p2 [label="Panggil API sumber tepercaya\n(batas waktu 6 detik) di\nthread terpisah", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="Pemanggilan\nberhasil?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Simpan data dan waktu ke\ncache", shape="box", style="filled", fillcolor="#FFFFFF"];
o2 [label="Tampilkan data terbaru dari\nweb", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d3 [label="Ada cache lama?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o3 [label="Tampilkan cache lama (mode\noffline)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
o4 [label="Tampilkan pesan: tidak dapat\nmemuat, periksa koneksi", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> p1;
p1 -> d1;
d1 -> o1 [label="Ya"];
d1 -> p2 [label="Tidak"];
p2 -> d2;
d2 -> p3 [label="Ya"];
p3 -> o2;
d2 -> d3 [label="Tidak"];
d3 -> o3 [label="Ya"];
d3 -> o4 [label="Tidak"];
o1 -> x;
o2 -> x;
o3 -> x;
o4 -> x;
}