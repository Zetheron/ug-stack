digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 7 - Tandai Selesai dan Hitung Progres"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Mahasiswa memilih modul", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p1 [label="Baca progress.json", shape="box", style="filled", fillcolor="#FFFFFF"];
d1 [label="ID modul sudah ada\ndi daftar selesai\npengguna?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Hapus ID dari daftar selesai\n(batal selesai)", shape="box", style="filled", fillcolor="#FFFFFF"];
p3 [label="Tambahkan ID ke daftar\nselesai", shape="box", style="filled", fillcolor="#FFFFFF"];
p4 [label="Simpan progress.json", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="Penyimpanan\nberhasil?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
e [label="Tampilkan pesan kesalahan\nfile", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d3 [label="Jumlah modul = 0?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
z [label="persen = 0", shape="box", style="filled", fillcolor="#FFFFFF"];
p5 [label="jumlah = 0; untuk setiap ID\nmodul: jika ada di daftar\nselesai maka jumlah + 1", shape="box", style="filled", fillcolor="#FFFFFF"];
p6 [label="persen = jumlah x 100 /\ntotal modul", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Tampilkan progress bar dan\npersentase", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> p1;
p1 -> d1;
d1 -> p2 [label="Ya"];
d1 -> p3 [label="Tidak"];
p2 -> p4;
p3 -> p4;
p4 -> d2;
d2 -> e [label="Tidak"];
d2 -> d3 [label="Ya"];
d3 -> z [label="Ya"];
d3 -> p5 [label="Tidak"];
p5 -> p6;
z -> o;
p6 -> o;
o -> x;
e -> x;
}