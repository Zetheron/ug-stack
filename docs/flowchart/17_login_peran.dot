digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 17 - Login dengan Pilihan Peran (Mahasiswa / Dosen / Admin)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai (halaman login)", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
r [label="Pilih peran: Mahasiswa\n(NPM/username), Dosen\n(username/NIDN), atau Admin", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d0 [label="Peran mahasiswa?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
reg [label="Tampilkan tautan Daftar\n(jika pendaftaran mandiri\ndibuka)", shape="box", style="filled", fillcolor="#FFFFFF"];
nr [label="Dosen/Admin: tanpa\npendaftaran mandiri; akun\ndibuat admin", shape="box", style="filled", fillcolor="#FFFFFF"];
in [label="Input NPM/username dan\npassword", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
a [label="auth.login(username,\npassword, peran_dipilih) -\nFlowchart 2", shape="box", style="filled", fillcolor="#FFFFFF"];
d1 [label="Username dan\npassword benar?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
e1 [label="Tampilkan pesan gagal\n(hitung percobaan, kunci\nakun)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d2 [label="Peran akun sama\ndengan peran yang\ndipilih?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
e2 [label="Tampilkan: akun terdaftar\nsebagai peran lain; catat\nLOGIN_PERAN_SALAH (bukan\npercobaan gagal)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d3 [label="Wajib ganti\npassword?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
w [label="Tampilkan dialog wajib ganti\npassword (Flowchart 14)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
o [label="Buka Dashboard sesuai peran", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> r;
r -> d0;
d0 -> reg [label="Ya"];
d0 -> nr [label="Tidak"];
reg -> in;
nr -> in;
in -> a;
a -> d1;
d1 -> e1 [label="Tidak"];
d1 -> d2 [label="Ya"];
d2 -> e2 [label="Tidak"];
d2 -> d3 [label="Ya"];
d3 -> w [label="Ya"];
d3 -> o [label="Tidak"];
w -> o;
o -> x;
e1 -> x;
e2 -> x;
}