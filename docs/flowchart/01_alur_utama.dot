digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 1 - Alur Utama Aplikasi UG-Stack"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
i [label="Inisialisasi data: buat file\nJSON dan akun admin bila\nbelum ada", shape="box", style="filled", fillcolor="#FFFFFF"];
h [label="Tampilkan Beranda", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Aksi yang dipilih?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
t [label="Buka halaman materi:\nTutorial, Referensi, Quiz,\nSertifikat, Roadmap,\nPencarian, Try it (konten\nlive: Flowchart 8; quiz:\nFlowchart 9)", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="Sudah login?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
lg [label="Proses Login atau Registrasi\n(Flowchart 2 dan 3)", shape="box", style="filled", fillcolor="#FFFFFF"];
d3 [label="Login berhasil?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
dash [label="Tampilkan Dashboard sesuai\nperan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d4 [label="Peran pengguna?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
pa [label="Admin: kelola modul -\ntambah, ubah, hapus, cari\n(Flowchart 4, 5, 6)", shape="box", style="filled", fillcolor="#FFFFFF"];
pm [label="Mahasiswa: cari modul,\ntandai selesai, hitung\nprogres (Flowchart 5, 7)", shape="box", style="filled", fillcolor="#FFFFFF"];
d5 [label="Logout?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
lo [label="Hapus sesi pengguna", shape="box", style="filled", fillcolor="#FFFFFF"];
e [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> i;
i -> h;
h -> d1;
d1 -> t [label="Halaman materi"];
t -> h;
d1 -> d2 [label="Dashboard / Login"];
d2 -> dash [label="Ya"];
d2 -> lg [label="Tidak"];
lg -> d3;
d3 -> dash [label="Ya"];
d3 -> lg [label="Tidak"];
dash -> d4;
d4 -> pa [label="Admin"];
d4 -> pm [label="Mahasiswa"];
pa -> d5;
pm -> d5;
d5 -> d4 [label="Tidak"];
d5 -> lo [label="Ya"];
lo -> h;
d1 -> e [label="Keluar"];
}