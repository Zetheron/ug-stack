digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 19 - Login Admin dengan Kode Berputar 60 Detik"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai (halaman login)", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
t [label="Ketuk judul kartu 7 kali\n(atau buka tautan\n?key=KODE); tidak ada tombol\nadmin", shape="box", style="filled", fillcolor="#FFFFFF"];
in [label="Input username admin dan\nkode 16 karakter", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d0 [label="Kunci admin\nterkonfigurasi?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d1 [label="Sedang terkunci? (5\nkode salah -> 120\ndetik)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Ambil kode (dari URL bila\nada) dan ubah ke huruf kecil", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="16 hex dan sama\ndengan HMAC-\nSHA256(kunci, menit)\nuntuk menit -1, 0,\natau +1?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Hitung percobaan gagal;\nkunci 120 detik bila 5;\ncatat ADMIN_KODE_GAGAL", shape="box", style="filled", fillcolor="#FFFFFF"];
d3 [label="Kode sudah pernah\ndipakai?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Simpan kode sebagai terpakai\n(sekali pakai); hapus\ncatatan gagal", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Akun admin dengan\nusername itu ada?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o [label="Catat LOGIN_ADMIN_KODE; buka\nPanel Admin", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e [label="Tampilkan pesan kesalahan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> t;
t -> in;
in -> d0;
d0 -> e [label="Tidak"];
d0 -> d1 [label="Ya"];
d1 -> e [label="Ya"];
d1 -> p1 [label="Tidak"];
p1 -> d2;
d2 -> p2 [label="Tidak"];
p2 -> e;
d2 -> d3 [label="Ya"];
d3 -> e [label="Ya"];
d3 -> p3 [label="Tidak"];
p3 -> d4;
d4 -> e [label="Tidak"];
d4 -> o [label="Ya"];
o -> x;
e -> x;
}