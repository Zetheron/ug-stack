digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 20 - Laporan Mahasiswa untuk Dosen dan Admin"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Input kata kunci nama, kunci\nurut, naik/turun", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d0 [label="Pengguna admin atau\ndosen?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
e [label="Kembalikan daftar kosong", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
p1 [label="Baca users, progres, skor,\nlangganan; daftar modul", shape="box", style="filled", fillcolor="#FFFFFF"];
p2 [label="baris = daftar kosong; i = 0", shape="box", style="filled", fillcolor="#FFFFFF"];
d1 [label="Masih ada pengguna\nberikutnya? (while)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Peran mahasiswa dan\nnama cocok kata\nkunci?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Hitung persen modul selesai,\njumlah sertifikat, rata-rata\nskor terbaik; tambahkan ke\nbaris", shape="box", style="filled", fillcolor="#FFFFFF"];
p4 [label="Urutkan baris dengan merge\nsort buatan sendiri menurut\nkunci dan arah", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Tampilkan kartu mahasiswa\n(progres, sertifikat, skor,\npaket, kursus)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> d0;
d0 -> e [label="Tidak"];
d0 -> p1 [label="Ya"];
p1 -> p2;
p2 -> d1;
d1 -> d2 [label="Ya"];
d2 -> p3 [label="Ya"];
d2 -> d1 [label="Tidak"];
p3 -> d1;
d1 -> p4 [label="Tidak"];
p4 -> o;
o -> x;
e -> x;
}