digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 15 - Admin Membuat Akun (Mahasiswa / Dosen / Admin)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Input username, peran,\npassword sementara (boleh\nkosong)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d0 [label="Pengguna adalah\nadmin?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d1 [label="Peran valid? (admin,\ndosen, mahasiswa)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Username valid?\n(4-20 huruf/angka/_)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d3 [label="Password sementara\nkosong?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Buat password acak 12\nkarakter (huruf besar,\nkecil, angka)", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Password valid? (min\n8, huruf dan angka)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Baca users.json", shape="box", style="filled", fillcolor="#FFFFFF"];
d5 [label="Username sudah\ndipakai?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Hash password dengan salt\nacak; simpan akun dengan\ntanda wajib ganti; catat\nBUAT_AKUN", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Tampilkan password sementara\nuntuk diberikan ke pengguna\n(tombol salin)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e [label="Tampilkan pesan kesalahan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> d0;
d0 -> e [label="Tidak"];
d0 -> d1 [label="Ya"];
d1 -> e [label="Tidak"];
d1 -> d2 [label="Ya"];
d2 -> e [label="Tidak"];
d2 -> d3 [label="Ya"];
d3 -> p1 [label="Ya"];
d3 -> d4 [label="Tidak"];
p1 -> d4;
d4 -> e [label="Tidak"];
d4 -> p2 [label="Ya"];
p2 -> d5;
d5 -> e [label="Ya"];
d5 -> p3 [label="Tidak"];
p3 -> o;
o -> x;
e -> x;
}