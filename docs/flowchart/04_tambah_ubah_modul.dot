digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 4 - Tambah dan Ubah Modul (Admin)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
d0 [label="Pengguna adalah\nadmin?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
in [label="Input judul, bahasa, level,\ndurasi, deskripsi", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Data valid? (judul\n3-60, bahasa dan\nlevel terdaftar,\ndurasi 1-600,\ndeskripsi <= 200)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Mode tambah?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="ID baru = ID terbesar + 1;\ntambahkan ke daftar modul", shape="box", style="filled", fillcolor="#FFFFFF"];
p2 [label="Cari modul berdasarkan ID", shape="box", style="filled", fillcolor="#FFFFFF"];
d3 [label="Modul ditemukan?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Ganti data modul dengan data\nbaru", shape="box", style="filled", fillcolor="#FFFFFF"];
p4 [label="Simpan modules.json", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Penyimpanan\nberhasil?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o [label="Tampilkan berhasil; muat\nulang daftar", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e0 [label="Tampilkan: hanya admin", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e1 [label="Tampilkan pesan validasi", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e2 [label="Tampilkan: modul tidak\nditemukan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
e3 [label="Tampilkan pesan kesalahan\nfile", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> d0;
d0 -> e0 [label="Tidak"];
d0 -> in [label="Ya"];
in -> d1;
d1 -> e1 [label="Tidak"];
d1 -> d2 [label="Ya"];
d2 -> p1 [label="Ya"];
d2 -> p2 [label="Tidak"];
p2 -> d3;
d3 -> e2 [label="Tidak"];
d3 -> p3 [label="Ya"];
p1 -> p4;
p3 -> p4;
p4 -> d4;
d4 -> e3 [label="Tidak"];
d4 -> o [label="Ya"];
o -> x;
e0 -> x;
e1 -> x;
e2 -> x;
e3 -> x;
}