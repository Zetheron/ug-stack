digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 16 - Pemilihan Penyimpanan dan Pembacaan Data"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai (aplikasi dibuka)", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
d1 [label="Variabel\nDATABASE_URL ada?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
pg [label="Pakai backend PostgreSQL\n(server online, data di\nNeon)", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="Berjalan sebagai\naplikasi Android/iOS\n(bukan web)?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
cs [label="Pakai backend penyimpanan\nperangkat\n(SharedPreferences) agar\ndata awet", shape="box", style="filled", fillcolor="#FFFFFF"];
fb [label="Pakai backend berkas JSON\n(folder data)", shape="box", style="filled", fillcolor="#FFFFFF"];
p1 [label="load_json(nama, bawaan):\nbaca teks dari backend", shape="box", style="filled", fillcolor="#FFFFFF"];
d3 [label="Data ada?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Simpan data bawaan", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Isi data berupa JSON\nvalid?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p3 [label="Simpan salinan nama.corrupt;\nsimpan data bawaan", shape="box", style="filled", fillcolor="#FFFFFF"];
o [label="Kembalikan data ke program", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> d1;
d1 -> pg [label="Ya"];
d1 -> d2 [label="Tidak"];
d2 -> cs [label="Ya"];
d2 -> fb [label="Tidak"];
pg -> p1;
cs -> p1;
fb -> p1;
p1 -> d3;
d3 -> p2 [label="Tidak"];
d3 -> d4 [label="Ya"];
p2 -> o;
d4 -> o [label="Ya"];
d4 -> p3 [label="Tidak"];
p3 -> o;
o -> x;
}