digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 3 - Registrasi Akun"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
in [label="Input username, password,\nkonfirmasi", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Username valid?\n(4-20 karakter\nhuruf/angka/_)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d2 [label="Password valid? (min\n8, huruf dan angka)", shape="diamond", style="filled", fillcolor="#FFF4A3"];
d3 [label="Konfirmasi sama\ndengan password?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p1 [label="Baca users.json", shape="box", style="filled", fillcolor="#FFFFFF"];
d4 [label="Username sudah\ndipakai?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
p2 [label="Hash password dengan salt\nacak; tambah pengguna (peran\nmahasiswa)", shape="box", style="filled", fillcolor="#FFFFFF"];
p3 [label="Simpan users.json", shape="box", style="filled", fillcolor="#FFFFFF"];
d5 [label="Penyimpanan\nberhasil?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
o [label="Tampilkan Registrasi\nberhasil; buka halaman Login", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
err [label="Tampilkan pesan kesalahan", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
x [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> in;
in -> d1;
d1 -> err [label="Tidak"];
d1 -> d2 [label="Ya"];
d2 -> err [label="Tidak"];
d2 -> d3 [label="Ya"];
d3 -> err [label="Tidak"];
d3 -> p1 [label="Ya"];
p1 -> d4;
d4 -> err [label="Ya"];
d4 -> p2 [label="Tidak"];
p2 -> p3;
p3 -> d5;
d5 -> err [label="Tidak"];
d5 -> o [label="Ya"];
o -> x;
err -> x;
}