digraph G {
graph [rankdir=TB, labelloc=t, fontsize=20, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, pad=0.3, label="Flowchart 12 - Menu Aplikasi Konsol (cli.py)"];
node [fontname="DejaVu Sans", fontsize=12, penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=11];
s [label="Mulai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
p0 [label="Inisialisasi data\n(auth.init_data)", shape="box", style="filled", fillcolor="#FFFFFF"];
m [label="Tampilkan menu awal: 1\nLogin, 2 Daftar, 0 Keluar", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d1 [label="Pilihan?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
l [label="Login maksimal 3 kali\n(while): auth.login", shape="box", style="filled", fillcolor="#FFFFFF"];
d2 [label="Login berhasil?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
g [label="Jika password sementara:\nwajib ganti (Flowchart 14)", shape="box", style="filled", fillcolor="#FFFFFF"];
m2 [label="Tampilkan menu sesuai peran\n(admin / mahasiswa)", shape="parallelogram", style="filled", fillcolor="#E1F5FE"];
d3 [label="Pilihan menu?", shape="diamond", style="filled", fillcolor="#FFF4A3"];
a [label="Jalankan aksi: tampil, cari,\ntambah, ubah, hapus, ekspor,\nlog, progres, ganti password", shape="box", style="filled", fillcolor="#FFFFFF"];
lo [label="Logout: catat audit LOGOUT", shape="box", style="filled", fillcolor="#FFFFFF"];
r [label="Proses registrasi (Flowchart\n3)", shape="box", style="filled", fillcolor="#FFFFFF"];
e [label="Selesai", shape="ellipse", style="filled", fillcolor="#C8E6C9"];
s -> p0;
p0 -> m;
m -> d1;
d1 -> l [label="1"];
d1 -> r [label="2"];
r -> m;
d1 -> e [label="0"];
l -> d2;
d2 -> m [label="Tidak"];
d2 -> g [label="Ya"];
g -> m2;
m2 -> d3;
d3 -> a [label="1-8"];
a -> m2;
d3 -> lo [label="9"];
lo -> m;
d3 -> e [label="0"];
}